# ─────────────────────────────────────────────────────────────
#  VeriPulse environment template — copy to .env.local and fill.
#  NEVER commit .env.local. Values here are placeholders only.
# ─────────────────────────────────────────────────────────────

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini (summaries, vision OCR, embeddings) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# --- Vehicle RC verification (choose one provider) ---
VAHAN_PROVIDER=surepass            # surepass | cashfree
SUREPASS_API_TOKEN=your-surepass-token
CASHFREE_CLIENT_ID=your-cashfree-id
CASHFREE_CLIENT_SECRET=your-cashfree-secret

# --- RazorpayX (instant UPI payouts) ---
RAZORPAYX_KEY_ID=your-razorpayx-key-id
RAZORPAYX_KEY_SECRET=your-razorpayx-key-secret
RAZORPAYX_ACCOUNT_NUMBER=your-source-account-number
RAZORPAYX_WEBHOOK_SECRET=your-webhook-signing-secret

# --- Affiliate postback ---
# Shared secret the merchant/aggregator includes on the postback URL.
AFFILIATE_POSTBACK_SECRET=generate-a-long-random-string

# --- Ads ---
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxx/xxxxxxxx
NEXT_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxx/xxxxxxxx

# --- Revenue split ---
# Payout policy (min ₹100, trust >= 70) is fixed inside request_upi_payout
# in SQL so no client or env misconfiguration can loosen it.
PLATFORM_SHARE_PCT=70
REVIEWER_SHARE_PCT=20
SENTINEL_SHARE_PCT=10

# --- Mobile build: native shell points here for API calls ---
NEXT_PUBLIC_API_ORIGIN=https://app.veripulse.example
