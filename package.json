{
  "name": "veripulse",
  "version": "2.4.0",
  "private": true,
  "description": "Crowdsourced, fact-checked news & verified-owner product intelligence platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:mobile": "node scripts/mobile-export.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap run android",
    "cap:ios": "npm run cap:sync && npx cap run ios",
    "test": "node --experimental-strip-types --no-warnings --test tests/unit.test.ts tests/e2e-user-flows.test.ts",
    "test:db": "bash scripts/db-acceptance.sh",
    "video:preview": "remotion preview remotion/index.ts",
    "video:render": "remotion render remotion/index.ts VeriPulseLandscape out/veripulse-promo.mp4"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/geolocation": "^6.1.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/share": "^6.0.3",
    "@remotion/cli": "^4.0.538",
    "@remotion/tailwind": "^4.0.538",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.538",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/ios": "^6.2.2",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
